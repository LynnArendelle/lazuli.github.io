            "content_html": "<figure class=\"post__image\"><img loading=\"lazy\"  src=\"https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/2025-01-30_155357.png\" alt=\"\" width=\"1317\" height=\"473\" sizes=\"(max-width: 1920px) 100vw, 1920px\" srcset=\"https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-xs.png 640w ,https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-sm.png 768w ,https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-md.png 1024w ,https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-lg.png 1366w ,https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-xl.png 1600w ,https://lynnarendelle.github.io/lazuli.github.io/media/posts/3/responsive/2025-01-30_155357-2xl.png 1920w\"></figure>",
